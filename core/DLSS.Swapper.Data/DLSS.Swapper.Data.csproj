<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app's data layer, without the app.

    Everything here used to live in src/ and be compiled into the WinUI executable, which meant the
    command line had to reference that executable to reach a Game or a swap - and so dragged in the
    entire Windows App SDK behind it. That is 154 MB of WinUI, the WinRT projection, onnxruntime and
    DirectML for a program that opens no window and uses none of them.

    So the headless half lives here instead. DLSS.Swapper.Core stays as it was: platform neutral,
    net10.0, with its own tests. This sits between the two - it needs Windows because it reads the
    registry and talks to NvAPI, but it needs nothing that draws.

    The namespaces are unchanged (DLSS_Swapper.*), because they were never UI namespaces. Nothing
    that moved here needed its usings rewritten.
  -->

  <PropertyGroup>
    <!-- Windows, not neutral: the registry, NvAPI and the Win32 signature checks all need it. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DLSS_Swapper</RootNamespace>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release;Debug_Portable;Release_Portable</Configurations>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- The icon a game is read out of is extracted through a Win32 call, which needs pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug_Portable'">
    <DefineConstants>$(DefineConstants);DEBUG;PORTABLE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release_Portable'">
    <DefineConstants>$(DefineConstants);RELEASE;PORTABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      internal stays internal. Hundreds of types here are internal and used by the app and the
      command line, and widening every one of them to public to cross an assembly boundary would be
      a worse change than this line. Core does the same for its tests.
    -->
    <InternalsVisibleTo Include="DLSS Swapper" />
    <InternalsVisibleTo Include="dlss-swapper-cli" />
    <InternalsVisibleTo Include="DLSS.Swapper.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DLSS.Swapper.Core\DLSS.Swapper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
    <PackageReference Include="AsyncAwaitBestPractices.MVVM" Version="10.0.0" />
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />

    <!--
      A source generator, so it adds nothing to what ships - it writes the three Win32 signatures
      named in NativeMethods.txt, which is how an EA game's icon is read off its executable.
    -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <PackageReference Include="sqlite-net-e" Version="1.11.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!--
    Linked rather than moved, for now. This is how the set of files that actually has to move is
    being found: the compiler decides, rather than a guess. Once it builds, they move here for real
    and this turns into an ordinary glob.
  -->
  <ItemGroup>
    <!--
      The exclusions are the files that genuinely draw: a Visibility, a collection view, a dialog.
      Six of the ninety five in src/Data, which is the whole reason this split is worth doing.
    -->
    <Compile Include="..\..\src\Data\**\*.cs"
             Exclude="..\..\src\Data\obj\**\*.cs;
                      ..\..\src\Data\Game.Ui.cs;
                      ..\..\src\Data\GameViews.cs;
                      ..\..\src\Data\WindowPositionRect.Ui.cs;
                      ..\..\src\Data\DllUsage.cs;
                      ..\..\src\Data\GameFilterTab.cs;
                      ..\..\src\Data\GameGroup.cs;
                      ..\..\src\Data\AccentPalette.cs;
                      ..\..\src\Data\AccentResolver.cs;
                      ..\..\src\Data\GitHub\GitHubUpdater.cs">
      <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\src\Messages\*.cs" Link="Messages\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Interfaces\IGameLibrary.cs" Link="Interfaces\IGameLibrary.cs" />
    <Compile Include="..\..\src\Interfaces\LocalizedViewModelBase.cs" Link="Interfaces\LocalizedViewModelBase.cs" />
    <Compile Include="..\..\src\Attributes\*.cs" Link="Attributes\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Helpers\FSR31\*.cs" Link="Helpers\FSR31\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Extensions\*.cs" Link="Extensions\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\JsonConverters\*.cs" Link="JsonConverters\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Database.cs" Link="Database.cs" />
    <Compile Include="..\..\src\Logger.cs" Link="Logger.cs" />
    <Compile Include="..\..\src\Storage.cs" Link="Storage.cs" />
    <Compile Include="..\..\src\UiThread.cs" Link="UiThread.cs" />
    <Compile Include="..\..\src\Win32.cs" Link="Win32.cs" />
    <Compile Include="..\..\src\WinTrust.cs" Link="WinTrust.cs" />
    <Compile Include="..\..\src\Crypt32.cs" Link="Crypt32.cs" />
    <Compile Include="..\..\src\ProxySettings.cs" Link="ProxySettings.cs" />
    <Compile Include="..\..\src\BuildInfo.cs" Link="BuildInfo.cs" />
    <Compile Include="..\..\src\SourceGenerationContext.cs" Link="SourceGenerationContext.cs" />
    <Compile Include="..\..\src\LoadingMessage.cs" Link="LoadingMessage.cs" />
    <Compile Include="..\..\src\Settings.cs" Link="Settings.cs" />
    <Compile Include="..\..\src\Helpers\AppHttpClient.cs" Link="Helpers\AppHttpClient.cs" />
    <Compile Include="..\..\src\Helpers\CommonHelpers.cs" Link="Helpers\CommonHelpers.cs" />
    <Compile Include="..\..\src\Helpers\DLSSSettingsManager.cs" Link="Helpers\DLSSSettingsManager.cs" />
    <Compile Include="..\..\src\Helpers\FileDownloader.cs" Link="Helpers\FileDownloader.cs" />
    <Compile Include="..\..\src\Helpers\PathHelpers.cs" Link="Helpers\PathHelpers.cs" />
    <Compile Include="..\..\src\Helpers\LanguageManager.cs" Link="Helpers\LanguageManager.cs" />
    <Compile Include="..\..\src\Helpers\ResourceHelper.cs" Link="Helpers\ResourceHelper.cs" />
    <Compile Include="..\..\src\Language\TranslationRow.cs" Link="Language\TranslationRow.cs" />
    <Compile Include="..\..\src\Helpers\StaticContext.cs" Link="Helpers\StaticContext.cs" />
    <Compile Include="..\..\src\Helpers\SystemDetails.cs" Link="Helpers\SystemDetails.cs" />
    <Compile Include="..\..\src\Collections\RefreshableObservableCollection.cs" Link="Collections\RefreshableObservableCollection.cs" />
  </ItemGroup>

</Project>
