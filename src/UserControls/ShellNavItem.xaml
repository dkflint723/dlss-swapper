<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.ShellNavItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootShellNavItem">

    <Button
        x:Name="ItemButton"
        Height="36"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Padding="18,0"
        CornerRadius="0"
        BorderThickness="0"
        Background="Transparent"
        Click="ItemButton_Click">
        <Grid ColumnSpacing="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The active marker is flush to the window edge rather than an inset pill, so it reads
                as the page's own edge rather than as a selected list item.
            -->
            <Border
                x:Name="ActiveBar"
                Grid.ColumnSpan="3"
                Width="2"
                Height="18"
                HorizontalAlignment="Left"
                Margin="-18,0,0,0"
                Background="{StaticResource DsAccentBrush}"
                Visibility="Collapsed" />

            <FontIcon
                x:Name="ItemGlyph"
                Grid.Column="0"
                FontSize="15"
                VerticalAlignment="Center"
                Foreground="{ThemeResource DsTextPrimaryBrush}" />

            <TextBlock
                x:Name="ItemLabel"
                Grid.Column="1"
                FontSize="13"
                VerticalAlignment="Center"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource DsTextPrimaryBrush}" />

            <TextBlock
                x:Name="ItemTrailingCount"
                Grid.Column="2"
                FontSize="11"
                VerticalAlignment="Center"
                Foreground="{ThemeResource DsTextTertiaryBrush}" />
        </Grid>
    </Button>
</UserControl>
