<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootShellSidebar"
    Width="212">

    <Grid Background="{ThemeResource DsBgBrush}" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DsLineBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            No brand block. The window already says what the app is called, and the app icon sits in
            its title bar, so repeating both at the top of the sidebar spent the most prominent slot
            in the column on something the user already knew. The game count it carried is a count
            like any other, and now reads beside Games the way the dll count reads beside Upscalers.
        -->
        <StackPanel Grid.Row="0" Margin="0,18,0,0">
            <local:ShellNavItem
                Glyph="&#xE7FC;"
                Label="{x:Bind ViewModel.TranslationProperties.GamesText, Mode=OneWay}"
                TrailingCount="{x:Bind ViewModel.GameCountText, Mode=OneWay}"
                Section="Games"
                ActiveSection="{x:Bind ViewModel.ActiveSection, Mode=OneWay}"
                Invoked="NavItem_Invoked" />
            <local:ShellNavItem
                Glyph="&#xE8F1;"
                Label="{x:Bind ViewModel.TranslationProperties.UpscalersText, Mode=OneWay}"
                TrailingCount="{x:Bind ViewModel.UpscalerCountText, Mode=OneWay}"
                Section="Upscalers"
                ActiveSection="{x:Bind ViewModel.ActiveSection, Mode=OneWay}"
                Invoked="NavItem_Invoked" />
            <local:ShellNavItem
                Glyph="&#xE713;"
                Label="{x:Bind ViewModel.TranslationProperties.SettingsText, Mode=OneWay}"
                Section="Settings"
                ActiveSection="{x:Bind ViewModel.ActiveSection, Mode=OneWay}"
                Invoked="NavItem_Invoked" />
        </StackPanel>

        <!--
            The only always visible statement that this app is reversible. Everything else about
            backups is buried in a per game page, which is no use when someone is deciding whether
            to trust the thing at all.
        -->
        <!--
            No border. A card drew a box around content that fills barely half its width, so the
            empty right hand side became the most noticeable thing about it. Without the box it
            reads as the last block of the sidebar, on the same 18px edge as the nav items and with
            the same icon and gap, so it belongs to the column rather than sitting on top of it.
        -->
        <Border
            Grid.Row="2"
            Padding="18,0,18,14"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DsLineBrush}"
            Margin="0,0,0,0"
            Visibility="{x:Bind ViewModel.BackupCoverageVisibility, Mode=OneWay}">
            <!--
                A Grid rather than a horizontal StackPanel: a StackPanel measures its children with
                infinite width in its own direction, so wrapping text never wraps and simply runs
                off the 212px sidebar.
            -->
            <Grid ColumnSpacing="11" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Centred against the two lines rather than pinned to the first, which left it
                     sitting high and made the card look unbalanced. -->
                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE8F7;"
                    FontSize="15"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource DsTextTertiaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <!-- Label above, count below, so the number is what the eye lands on. -->
                    <TextBlock
                        Text="{x:Bind ViewModel.TranslationProperties.BackupCoverageLabel, Mode=OneWay}"
                        FontSize="11"
                        LineHeight="15"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource DsTextSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.BackupCoverageText, Mode=OneWay}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        LineHeight="15"
                        Margin="0,0,0,2"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource DsTextPrimaryBrush}" />
                    <HyperlinkButton
                        Padding="0"
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.FixTheOthersVisibility, Mode=OneWay}"
                        Click="FixTheOthers_Click">
                        <TextBlock
                            Text="{x:Bind ViewModel.FixTheOthersText, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{StaticResource DsAccentBrush}" />
                    </HyperlinkButton>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="3"
            Margin="18,0,18,16"
            Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
            FontSize="11"
            Foreground="{ThemeResource DsTextTertiaryBrush}" />
    </Grid>
</UserControl>
