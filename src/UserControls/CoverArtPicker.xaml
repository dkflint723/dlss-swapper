<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.CoverArtPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Two pages, not two stacked lists. Picking a game replaces the search with that game's
        covers, so only one list is ever on screen: a ContentDialog clips rather than scrolls and
        both lists at once did not fit inside one. Back returns to the matches, which are still
        there, rather than to a fresh search.
    -->
    <Grid Width="640" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Pre-filled with the game's name. It stays editable because a store's title and an art
            database's do not always agree, and the search is the only way to reconcile them.
        -->
        <Grid Grid.Row="0" ColumnSpacing="8" Visibility="{x:Bind ViewModel.SearchVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Header="{x:Bind ViewModel.TranslationProperties.SearchLabelText, Mode=OneWay}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="SearchBox_KeyDown" />

            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Height="32"
                Padding="16,0"
                CornerRadius="{StaticResource DsCornerRadius}"
                Content="{x:Bind ViewModel.TranslationProperties.SearchText, Mode=OneWay}"
                Command="{x:Bind ViewModel.SearchCommand}" />
        </Grid>

        <!-- What is happening, or what went wrong, in words rather than an empty area. -->
        <TextBlock
            Grid.Row="1"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Foreground="{ThemeResource DsTextSecondaryBrush}" />

        <!--
            Page one. A name search is fuzzy - "doom" returns two games called exactly "Doom" - so
            the year and stores are on every row, because they are the only things telling them apart.
        -->
        <StackPanel Grid.Row="2" Spacing="6" Visibility="{x:Bind ViewModel.GamesVisibility, Mode=OneWay}">
            <TextBlock
                Text="{x:Bind ViewModel.TranslationProperties.PickGameText, Mode=OneWay}"
                Foreground="{ThemeResource DsTextSecondaryBrush}" />

            <ListView
                MaxHeight="260"
                SelectionMode="Single"
                SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="usercontrols:CoverArtGameItem">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Detail}"
                                FontSize="12"
                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Page two. Nothing is written until one of these is chosen and the button is pressed. -->
        <StackPanel Grid.Row="3" Spacing="6" Visibility="{x:Bind ViewModel.CoversVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="28"
                    Padding="10,0"
                    CornerRadius="{StaticResource DsCornerRadius}"
                    Content="{x:Bind ViewModel.TranslationProperties.BackText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.BackCommand}" />

                <!-- Names the game, because the row that said which one it is has been replaced. -->
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind ViewModel.CoversHeading, Mode=OneWay}"
                    Foreground="{ThemeResource DsTextSecondaryBrush}" />
            </Grid>

            <!--
                Capped so it scrolls inside the dialog rather than growing past the bottom of it,
                and sized to whole rows: a row cut in half reads as art that failed to load rather
                than as a list with more below it.
            -->
            <GridView
                MaxHeight="376"
                SelectionMode="Single"
                SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
                ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="usercontrols:CoverArtImageItem">
                        <StackPanel Width="112" Spacing="4" Padding="0,4">
                            <Image Width="96" Height="144" Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage UriSource="{x:Bind ThumbnailUri}" DecodePixelWidth="96" />
                                </Image.Source>
                            </Image>
                            <TextBlock
                                Text="{x:Bind Detail}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource DsTextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>

        <!--
            Always offered, not only once a search has failed. A game can be missing from
            SteamGridDB entirely, and a manually added one often is - so the way out has to be
            visible before the search disappoints, not after.
        -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button
                Height="32"
                Padding="16,0"
                CornerRadius="{StaticResource DsCornerRadius}"
                Content="{x:Bind ViewModel.TranslationProperties.ChooseFileText, Mode=OneWay}"
                Command="{x:Bind ViewModel.BrowseCommand}" />

            <Button
                Height="32"
                Padding="16,0"
                Style="{StaticResource AccentButtonStyle}"
                CornerRadius="{StaticResource DsCornerRadius}"
                Content="{x:Bind ViewModel.TranslationProperties.ApplyText, Mode=OneWay}"
                Command="{x:Bind ViewModel.ApplyCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
