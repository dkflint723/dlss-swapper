<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootSettingsRow">

    <Grid
        Padding="0,14"
        ColumnSpacing="24"
        BorderThickness="0,0,0,1"
        BorderBrush="{ThemeResource DsLineBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            Empty on almost every row, and collapsed rather than blank when it is, so it charges no
            width and the titles all line up. It exists for the rows that can be dragged: the handle
            has to be inside the row for the hairline to run the row's full width under it.
        -->
        <FontIcon
            x:Name="LeadingGlyph"
            Grid.Column="0"
            FontSize="12"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            Foreground="{ThemeResource DsTextTertiaryBrush}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock
                x:Name="TitleText"
                FontSize="13"
                TextWrapping="Wrap"
                Foreground="{ThemeResource DsTextPrimaryBrush}" />

            <!--
                Not italic, and not a caption tucked under the control. A setting's explanation is
                what makes it answerable, so it reads as part of the label rather than as a footnote
                about it.
            -->
            <TextBlock
                x:Name="DescriptionText"
                FontSize="11"
                LineHeight="15"
                TextWrapping="Wrap"
                Foreground="{ThemeResource DsTextTertiaryBrush}" />
        </StackPanel>

        <ContentPresenter
            x:Name="ControlHost"
            Grid.Column="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Right" />
    </Grid>
</UserControl>
