<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.GameStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootGameStatusView">

    <!--
        Gaps live on the children rather than as ColumnSpacing on the grid. Most rows carry no
        glyph, and a spaced grid still charges for the empty column, which pushed the sentence a
        step right of the title it sits under, by a different amount depending on whether the row
        had a glyph. A collapsed child measures as nothing, margin included.
    -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VariantStates">
                <!--
                    Nothing differs in the paint any more. The card's caption moved out of the
                    gradient over the cover and onto a theme surface, so its ink is the theme's ink
                    and its sizes are the row's sizes. White at 11px existed only because it was
                    drawn on artwork; on the card surface in the light theme it measures 1.4:1.
                    The one thing still left to the variant is the busy ring, in the code behind.
                -->
                <VisualState x:Name="RowVariant" />

                <!--
                    The card restacks rather than repaints. A card is 200px wide, so the engine
                    list sitting beside the sentence left it about 116px and "Updates turned off"
                    truncated to "Updates turne…" — the sentence is the substance, so the list
                    that was squeezing it moves under instead. Spec §2.6 puts it on its own line
                    for the same reason.
                -->
                <VisualState x:Name="CardVariant">
                    <VisualState.Setters>
                        <Setter Target="StatusEngines.(Grid.Row)" Value="1" />
                        <Setter Target="StatusEngines.(Grid.Column)" Value="0" />
                        <Setter Target="StatusEngines.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="StatusEngines.HorizontalAlignment" Value="Left" />
                        <Setter Target="StatusEngines.Margin" Value="0,2,0,0" />
                        <Setter Target="StatusEngines.Foreground" Value="{ThemeResource DsTextTertiaryBrush}" />
                        <Setter Target="BusyRing.(Grid.Row)" Value="1" />
                        <Setter Target="BusyRing.(Grid.Column)" Value="0" />
                        <Setter Target="BusyRing.HorizontalAlignment" Value="Left" />
                        <Setter Target="BusyRing.Margin" Value="0,2,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The second row is only ever used by the card; a row keeps it at zero height. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FontIcon
            x:Name="StatusGlyph"
            Grid.Column="0"
            FontSize="11"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource DsTextPrimaryBrush}" />

        <TextBlock
            x:Name="StatusSentence"
            Grid.Column="1"
            FontSize="12"
            VerticalAlignment="Center"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis"
            Foreground="{ThemeResource DsTextSecondaryBrush}" />

        <!--
            Secondary ink rather than the tertiary the handoff specifies. Which upscalers a game
            ships is the substance of the row, not metadata, and at 10px tertiary measured about
            2.5:1 against the background.
        -->
        <TextBlock
            x:Name="StatusEngines"
            Grid.Column="2"
            FontSize="11"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            TextWrapping="NoWrap"
            Foreground="{ThemeResource DsTextSecondaryBrush}" />

        <!-- Shares the trailing cell with the engine list, which it replaces while a swap runs. -->
        <ProgressRing
            x:Name="BusyRing"
            Grid.Column="2"
            Width="16"
            Height="16"
            Margin="12,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
