<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.GameActionButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootGameActionButton">

    <Grid>
        <!-- The variant only changes how it is painted; the code behind owns that, and everything else. -->
        <Button
            x:Name="ActionButton"
            Height="32"
            Padding="16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="{StaticResource DsCornerRadius}" />

        <!--
            Shown in place of the button while this game is being written, rather than the button
            turning into a spinner. A spinner where a button was still looks like something you
            could press; a bar in the empty slot reads as the row being busy, which it is.
        -->
        <ProgressBar
            x:Name="ActionProgress"
            Width="150"
            Height="2"
            IsIndeterminate="True"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
