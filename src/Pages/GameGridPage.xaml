<Page
    x:Class="DLSS_Swapper.Pages.GameGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:data="using:DLSS_Swapper.Data"
    xmlns:system="using:System"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    mc:Ignorable="d"
    d:DataContext="pages:GameGridPageModel"
    Loaded="Page_Loaded"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Required"
    x:Name="RootGameGridPage">
    <Page.Resources>
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />
        <ct_converters:StringVisibilityConverter x:Key="InverseStringVisibilityConverter" EmptyValue="Visible" NotEmptyValue="Collapsed" />
        <converters:BitmapImageUriConverter x:Key="BitmapImageUriConverter" />
        <!--
            Hidden games are dimmed rather than absent. 0.25 was set when they only ever appeared
            alongside normal rows, where it read as "ignore this one". On the hidden tab they are
            the entire list, so it has to stay legible; 0.55 is the same ratio the tokens use for
            secondary text.
        -->
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueValue="0.55" FalseValue="1.0" NullValue="1.0" />

        <!--
            One header for both views. It was two identical copies, and a launcher group is the same
            thing whichever way the games under it are drawn.
        -->
        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="data:GameGroup">
            <Grid Margin="0" Visibility="{x:Bind Name, Converter={StaticResource StringVisibilityConverter}}">
                <TextBlock Text="{x:Bind Name}" Margin="0" Style="{StaticResource TitleTextBlockStyle}"/>
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="ListViewTemplate" x:DataType="pages:GameGridPageModel">
            <ListView ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}" ItemClick="GridAndListView_ItemClick" HorizontalAlignment="Stretch" SelectionMode="None" IsItemClickEnabled="True" Padding="20">

                <!--
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Padding" Value="12,0,0,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                -->

                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <!--
                            74px row with a 1px bottom rule rather than a card. The redesign drops
                            the vendor coloured badges: the technology is a word in the engines
                            column, and the state is a glyph plus a sentence, so nothing depends on
                            telling green from red.
                        -->
                        <Grid ColumnSpacing="16"
                              Height="74"
                              Padding="26,0"
                              BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource DsLineBrush}"
                              Background="Transparent"
                              Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <!--
                                        Checked rather than two items, so the row states the setting
                                        rather than only offering to change it.
                                    -->
                                    <ToggleMenuFlyoutItem
                                        Text="{Binding ElementName=RootGameGridPage, Path=ViewModel.TranslationProperties.NeverUpdateThisGameText, Mode=OneWay}"
                                        IsChecked="{x:Bind SkipUpdates, Mode=OneWay}"
                                        Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.ToggleSkipUpdatesCommand}"
                                        CommandParameter="{x:Bind}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Portrait, matching the 400x600 art the cache actually holds. The
                                handoff drew a 96x54 landscape thumbnail, which assumes key art this
                                app does not have: cropping a poster to 16:9 leaves a band through
                                its middle, which is unrecognisable for most games.
                            -->
                            <Border Grid.Column="0"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource DsLine2Brush}"
                                    CornerRadius="{StaticResource DsCornerRadius}"
                                    Width="44"
                                    Height="66"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource DsTextPrimaryBrush}" />

                                <!--
                                    The engine list rides on the status line rather than in a fixed
                                    130px column of its own. It used to be a column, which had to be
                                    kept in step with the card's copy of the same three fields by
                                    hand, and was not.
                                -->
                                <usercontrols:GameStatusView
                                    Variant="Row"
                                    Status="{x:Bind RowStatus, Mode=OneWay}" />
                            </StackPanel>

                            <usercontrols:GameActionButton
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Variant="Row"
                                Status="{x:Bind RowStatus, Mode=OneWay}"
                                Game="{x:Bind}"
                                Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.RowActionCommand}" />
                        </Grid>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </DataTemplate>

        <DataTemplate x:Key="GridVeiwTemplate" x:DataType="pages:GameGridPageModel">

            <GridView PointerWheelChanged="MainGridView_PointerWheelChanged" ManipulationMode="None" x:Name="MainGridView" ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridAndListView_ItemClick" Padding="20"  >

                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                </GridView.GroupStyle>

                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="8"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <!--
                            Matched to the card's radius. The container paints its own rest and
                            hover background with square corners, which showed at each corner of the
                            rounded card and read as a shadow that did not fit the shape.
                        -->
                        <Setter Property="CornerRadius" Value="{StaticResource DsCornerRadiusLarge}"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <Grid 
                            Width="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemWidth, Mode=OneWay}"
                            Height="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemHeight, Mode=OneWay}"
                            CornerRadius="{StaticResource DsCornerRadiusLarge}" Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}" BorderThickness="1" ColumnSpacing="0" RowSpacing="0" Margin="0,0,12,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Margin="20" TextWrapping="WrapWholeWords" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource ButtonForegroundColor}" />

                            <!-- Weird, but allows image to strecth centered rather than left align -->
                            <Border BorderThickness="0" FlowDirection="LeftToRight">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="1" />
                                </Border.RenderTransform>
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Border.Background>
                            </Border>

                            <!--
                                A gradient rather than a flat bar, so the cover fades into the
                                caption instead of being cut off by a hard edge. The bottom stop is
                                nearly opaque because white text has to stay readable over a bright
                                cover, not just a dark one.
                            -->
                            <Grid VerticalAlignment="Bottom" Padding="10,20,10,10">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.0" />
                                        <GradientStop Color="#99000000" Offset="0.4" />
                                        <GradientStop Color="#F2000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Grid.Background>

                                <!--
                                    The same status the list rows carry, from the same control,
                                    rather than a hardcoded "DLSS" label, a version number and
                                    vendor coloured badges. The card had been claiming every game
                                    was about DLSS regardless of what it actually ships.
                                -->
                                <usercontrols:GameStatusView
                                    Variant="Card"
                                    Status="{x:Bind RowStatus, Mode=OneWay}" />
                            </Grid>

                            <!--
                                The row's action, over the cover where it is visible while scanning
                                the grid. A glyph rather than a colour, so it is still readable to
                                anyone who cannot separate the vendor colours.
                            -->
                            <usercontrols:GameActionButton
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="8"
                                Variant="Card"
                                Status="{x:Bind RowStatus, Mode=OneWay}"
                                Game="{x:Bind}"
                                Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.RowActionCommand}" />
                        </Grid>
                    </DataTemplate>

                </GridView.ItemTemplate>
            </GridView>

        </DataTemplate>

        <usercontrols:ListGridViewTemplateSelector x:Key="TemplateSelector"
                                  ListViewTemplate="{StaticResource ListViewTemplate}"
                                  GridVeiwTemplate="{StaticResource GridVeiwTemplate}"/>
        
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,0,16,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.TranslationProperties.PageTitle, Mode=OneWay}" Margin="16,0,0,0" TextWrapping="NoWrap" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <muxc:ProgressRing IsActive="True" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"  />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Grid Width="300" Margin="10,0,0,0">
                    <TextBox x:Name="SearchBox"
                        Height="20"
                        Padding="8,5,32,0"
                        AcceptsReturn="True"
                        IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.TranslationProperties.SearchText, Mode=OneWay}"
                        TextChanged="{x:Bind ViewModel.SearchForGameEvent}" />

                    <Button x:Name="ClearButton"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,4,0"
                            Padding="4"
                            Visibility="{x:Bind SearchBox.Text, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                            Click="ClearSearchBox_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.NewDllsText, Mode=OneWay}" Command="{x:Bind ViewModel.UnknownAssetsFoundButtonCommand}" Visibility="{x:Bind data:GameManager.Instance.UnknownAssetsFound, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.UpdateAllGamesText, Mode=OneWay}" Command="{x:Bind ViewModel.UpdateAllGamesButtonCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE896;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.AddGameText, Mode=OneWay}" Command="{x:Bind ViewModel.AddManualGameButtonCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshGamesButtonCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Icon="Filter" Label="{x:Bind ViewModel.TranslationProperties.FilterText, Mode=OneWay}" Command="{x:Bind ViewModel.FilterGamesButtonCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE71C;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.ViewTypeText, Mode=OneWay}" Content="{x:Bind ViewModel.GameGridViewIcon, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.GridViewText, Mode=OneWay}" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.GridView}" />
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ListViewText, Mode=OneWay}" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.ListView}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </StackPanel>

            <InfoBar x:Name="AdminInfoBar"
                 Grid.Row="1"
                 IsOpen="True"
                 Severity="Warning"
                 IsClosable="False"
                 Title="Warning"
                 Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                 Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!--
                Filter tabs. Each carries the count of what it would show, from the same rule that
                decides what it shows, so the number cannot disagree with the list. A tab with
                nothing in it shows no number rather than a zero, which reads as an error.
            -->
            <Grid Grid.Row="2" Height="38" Margin="16,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{x:Bind ViewModel.FilterTabs, Mode=OneWay}" VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:GameFilterTab">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                Command="{Binding ElementName=RootGameGridPage, Path=ViewModel.SelectFilterCommand}"
                                CommandParameter="{x:Bind}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="2" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Opacity="{x:Bind LabelOpacity}">
                                        <TextBlock Text="{x:Bind Label}" FontSize="13" Foreground="{ThemeResource DsTextPrimaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind CountText}"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind CountVisibility}"
                                            Foreground="{ThemeResource DsTextSecondaryBrush}" />
                                    </StackPanel>

                                    <Border
                                        Grid.Row="1"
                                        Background="{ThemeResource DsTextPrimaryBrush}"
                                        Visibility="{x:Bind UnderlineVisibility}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Grid.Column="1"
                    Height="32"
                    Padding="16,0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource DsCornerRadius}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Content="{x:Bind ViewModel.ReviewUpdatesText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ReviewUpdatesVisibility, Mode=OneWay}"
                    Command="{x:Bind ViewModel.UpdateAllGamesButtonCommand}" />
            </Grid>
        </Grid>

        <ContentControl x:Name="MainContentControl" Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" Content="{x:Bind ViewModel, Mode=OneWay}" ContentTemplateSelector="{StaticResource TemplateSelector}" />
        
    </Grid>
</Page>

