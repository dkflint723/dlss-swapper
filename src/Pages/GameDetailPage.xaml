<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DLSS_Swapper.Pages.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:helpers="using:DLSS_Swapper.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:data="using:DLSS_Swapper.Data"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    x:Name="RootGameControl">

    <!--
        Escape leaves, the way Close did when this was a dialog. Placement hidden for the same
        reason the games page hides its own: the tip floats under whatever has focus.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed"  />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter"  />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToInvisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolToObjectConverter x:Key="FavouriteTextConverter" TrueValue="{Binding TranslationProperties.FavouritedText, Mode=OneWay}" FalseValue="{Binding TranslationProperties.ClickToFavouriteText, Mode=OneWay}" />
        <ct_converters:BoolToObjectConverter x:Key="FavouriteGlyphConverter" TrueValue="&#xE735;" FalseValue="&#xE734;" />
        <ct_converters:EmptyObjectToObjectConverter x:Key="NullObjectToBoolConverter" NotEmptyValue="True" EmptyValue="False" />
        <ct_converters:EmptyCollectionToObjectConverter  x:Key="EmptyCollectionToObjectConverter" NotEmptyValue="True" EmptyValue="False" />

        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadingConverter" DesierdState="Downloading" />
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadedConverter" DesierdState="Downloaded" />
        <converters:DLSSStateVisibilityConverter x:Key="IsNotFoundConverter" DesierdState="NotFound" />
        <converters:DLSSStateVisibilityConverter x:Key="IsImportedConverter" DesierdState="Imported" />
        <converters:BitmapImageUriConverter x:Key="BitmapImageUriConverter" />
        <converters:NullableBoolToObjectConverter x:Key="HideGameTextConverter" NullValue="{Binding TranslationProperties.ClickToHideText, Mode=OneWay}" FalseValue="{Binding TranslationProperties.ClickToHideText, Mode=OneWay}" TrueValue="{Binding TranslationProperties.HiddenText, Mode=OneWay}" />
        <converters:NullableBoolToObjectConverter x:Key="HideGameGlyphConverter" NullValue="&#xE7B3;" FalseValue="&#xE7B3;" TrueValue="&#xED1A;"  />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:NullToInverseVisibilityConverter x:Key="NullToInverseVisibilityConverter" />
        


        <Style x:Key="InformationalFontIcon" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE946;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource InformationalIconColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Page.Resources>

    <Grid Padding="32,16,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            A page header, which this surface never had: nothing set the dialog's Title, so the game
            you were looking at was named only by a text field halfway down it.
        -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <Button
                VerticalAlignment="Center"
                Content="{x:Bind ViewModel.TranslationProperties.BackToGamesText, Mode=OneWay}"
                Command="{x:Bind ViewModel.CloseCommand}" />

            <TextBlock
                Text="{x:Bind ViewModel.Game.Title, Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <Grid ColumnSpacing="20" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="8">
                <!--
                    The same card exists in ManuallyAddGameControl.xaml - a change here almost
                    certainly belongs there too. Painted with the Ds tokens the rest of the app
                    uses; it carried pre-redesign Card* brushes, so the one screen about a single
                    game framed its art in colours nothing else used.
                -->
                <Grid Width="200" Height="300" CornerRadius="{StaticResource DsCornerRadiusLarge}" BorderThickness="1" ColumnSpacing="0" RowSpacing="0" Margin="0" Background="{ThemeResource DsCoverPlaceholderBrush}" BorderBrush="{ThemeResource DsLine2Brush}">

                    <!-- Padding="{ThemeResource ContentDialogPadding}" -->

                    <!-- Weird, but allows image to strecth centered rather than left align -->
                    <Border BorderThickness="0" Width="200" Height="300" FlowDirection="LeftToRight">
                        <Border.RenderTransform>
                            <CompositeTransform ScaleX="1" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill">
                                <ImageBrush.ImageSource>
                                    <!-- Drawn at a pinned 200x300; see the games page's list row. -->
                                    <BitmapImage DecodePixelType="Logical" DecodePixelWidth="200" UriSource="{x:Bind ViewModel.Game.CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}"/>
                                </ImageBrush.ImageSource>
                            </ImageBrush>
                        </Border.Background>
                    </Border>

                    <Button HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch" AutomationProperties.Name="{x:Bind ViewModel.CoverButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.AddCoverImageCommand}" AllowDrop="True" DragEnter="CoverButton_DragEnter" DragOver="CoverButton_DragOver" Drop="CoverButton_Drop" />
                </Grid>
                <Button Content="{x:Bind ViewModel.CoverButtonText, Mode=OneWay}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AddCoverImageCommand}" />
                <Button Content="{x:Bind ViewModel.TranslationProperties.FindCoverArtText, Mode=OneWay}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.FindCoverArtCommand}" />
            </StackPanel>

            <Grid Grid.Column="1" >

                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Spacing="4">

                    <InfoBar
                        Visibility="{x:Bind ViewModel.Game.IsReadyToPlay, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Severity="Warning"
                        IsOpen="True"
                        IsClosable="False"
                        Message="{x:Bind ViewModel.TranslationProperties.GameNotReadyToPlayStateText, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind ViewModel.TranslationProperties.HelpText, Mode=OneWay}" Command="{x:Bind ViewModel.ReadyToPlayStateMoreInformationCommand}" HorizontalAlignment="Right" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <TextBlock Text="{x:Bind ViewModel.TranslationProperties.NameText, Mode=OneWay}" FontWeight="Bold" />
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" VerticalAlignment="Stretch" Text="{x:Bind ViewModel.GameTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsManuallyAdded, Converter={StaticResource BoolNegationConverter}}" />

                        <!--
                            A word rather than a floppy disk glyph. It is the only control on this
                            surface that commits a typed edit, and it was the one thing here whose
                            meaning you had to already know.
                        -->
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            Content="{x:Bind ViewModel.TranslationProperties.SaveText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsManuallyAdded, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsEnabled="{x:Bind ViewModel.GameTitleHasChanged, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SaveTitleCommand}" />
                    </Grid>

                    <!--
                        The path is a fact, not a field. It was a disabled TextBox, which looks like
                        somewhere you could type and then refuses, and the only way to open it was a
                        nameless folder glyph — that is a labelled button in the action row now.
                        Selectable, because copying a path out of here is a real thing to want.
                    -->
                    <TextBlock Text="{x:Bind ViewModel.TranslationProperties.InstallPathText, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Game.InstallPath}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{ThemeResource DsTextSecondaryBrush}" />

                    <!--
                        One row per upscaler this game actually has, in the shape the settings page
                        uses. It was nine hardcoded controls, one per upscaler, each a bold name
                        over a dropdown — and each deciding for itself whether the game had that
                        dll, which is GameEngines' question asked a second time. Everything else
                        about an upscaler lived in icon buttons beside it, or nowhere: the version
                        available, whether an original was kept, whether the dll was found twice.
                    -->
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.UpscalerRowList, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:UpscalerRowStatus">
                                <Grid
                                    Padding="0,14"
                                    ColumnSpacing="16"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource DsLineBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Glyph="{x:Bind Glyph}"
                                        Foreground="{ThemeResource DsTextSecondaryBrush}"
                                        Visibility="{x:Bind Glyph, Converter={StaticResource StringVisibilityConverter}}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource DsTextPrimaryBrush}" />

                                        <TextBlock
                                            Text="{x:Bind Sentence}"
                                            FontSize="11"
                                            LineHeight="15"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource DsTextTertiaryBrush}" />
                                    </StackPanel>

                                    <!--
                                        Carries its own command rather than reaching back through
                                        the page: an ElementName binding does not resolve from
                                        inside a template placed in a content property.
                                    -->
                                    <Button
                                        Grid.Column="2"
                                        MinWidth="150"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        Content="{x:Bind ActionLabel}"
                                        IsEnabled="{x:Bind IsLocked, Converter={StaticResource BoolNegationConverter}}"
                                        Command="{Binding ElementName=RootGameControl, Path=ViewModel.ChangeRecordCommand}"
                                        CommandParameter="{x:Bind AssetType}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        The presets, in the same row shape, under their own heading rather than
                        interleaved beside the upscaler they belong to. Each says what it does, and
                        when it cannot be set it says which of the three reasons that is, instead of
                        a disabled dropdown beside an error icon that only appeared for one of them.
                    -->
                    <usercontrols:SectionRule
                        Margin="0,28,0,4"
                        Visibility="{x:Bind ViewModel.AnyPresetVisibility, Mode=OneWay}"
                        Label="{x:Bind ViewModel.TranslationProperties.PresetsSectionText, Mode=OneWay}" />

                    <usercontrols:SettingsRow
                        Visibility="{x:Bind ViewModel.DlssPresetVisibility, Mode=OneWay}"
                        Title="{x:Bind ViewModel.TranslationProperties.DLSSPresetText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.DlssPresetDescription, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox
                                MinWidth="180"
                                SelectedItem="{x:Bind ViewModel.SelectedDlssPreset, Mode=TwoWay}"
                                ItemsSource="{x:Bind ViewModel.DlssPresetOptions}"
                                DisplayMemberPath="Name"
                                IsEnabled="{x:Bind ViewModel.CanSelectDlssPreset, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Visibility="{x:Bind ViewModel.DlssDPresetVisibility, Mode=OneWay}"
                        Title="{x:Bind ViewModel.TranslationProperties.DLSSDPresetText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.DlssPresetDescription, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox
                                MinWidth="180"
                                SelectedItem="{x:Bind ViewModel.SelectedDlssDPreset, Mode=TwoWay}"
                                ItemsSource="{x:Bind ViewModel.DlssDPresetOptions}"
                                DisplayMemberPath="Name"
                                IsEnabled="{x:Bind ViewModel.CanSelectDlssDPreset, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Visibility="{x:Bind ViewModel.DlssGPresetVisibility, Mode=OneWay}"
                        Title="{x:Bind ViewModel.TranslationProperties.DLSSGPresetText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.DlssPresetDescription, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox
                                MinWidth="180"
                                SelectedItem="{x:Bind ViewModel.SelectedDlssGPreset, Mode=TwoWay}"
                                ItemsSource="{x:Bind ViewModel.DlssGPresetOptions}"
                                DisplayMemberPath="Name"
                                IsEnabled="{x:Bind ViewModel.CanSelectDlssGPreset, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <!--
                        The pickers for upscalers this game does not have are hidden rather than
                        left reading "Not found". They are still worth naming, so they are named
                        here, in one line instead of eight controls.
                    -->
                    <TextBlock
                        Margin="0,16,0,0"
                        Text="{x:Bind ViewModel.NotPresentSummary, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NotPresentSummaryVisibility, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource DsTextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>

        <!--
            The action row, which used to be two ControlTemplates injected into the dialog's own
            template at OnApplyTemplate. A page just has a row.
        -->
        <Grid Grid.Row="2" Padding="0,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DsLineBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" XYFocusKeyboardNavigation="Enabled" Padding="0"  Spacing="8">


                <!--
                    Eight unlabelled glyphs became three labelled actions and one named menu.
                    Every one of the eight was a tooltip away from being unreadable, and a tooltip
                    is not a name: it never reaches a screen reader and does not appear on keyboard
                    focus. Two of them could also only ever refuse — Launch on a library that
                    cannot be launched from, and Update all on a game with nothing to update — so
                    both now appear only when they can act.
                -->
                <Button
                    Style="{ThemeResource AccentButtonStyle}"
                    Content="{Binding TranslationProperties.UpdateAllDllsText, Mode=OneWay}"
                    Command="{Binding UpdateAllDllsCommand}"
                    Visibility="{Binding HasUpdatesVisibility}" />

                <Button
                    Content="{Binding TranslationProperties.LaunchText, Mode=OneWay}"
                    Command="{Binding LaunchCommand}"
                    Visibility="{Binding CanLaunchVisibility}" />

                <Button
                    Content="{Binding TranslationProperties.OpenFolderText, Mode=OneWay}"
                    Command="{Binding OpenInstallPathCommand}" />

                <Button
                    Width="32"
                    Padding="0"
                    ToolTipService.ToolTip="{Binding TranslationProperties.MoreActionsText, Mode=OneWay}"
                    AutomationProperties.Name="{Binding TranslationProperties.MoreActionsText, Mode=OneWay}">
                    <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout ShouldConstrainToRootBounds="True">
                            <!--
                                Checked rather than two items, so the menu states the setting rather
                                than only offering to change it. This is the one that greys out
                                every row on this page, and until now it could only be set by
                                right-clicking the game on another page — which the lock's own
                                tooltip had to tell people to go and do.
                            -->
                            <ToggleMenuFlyoutItem
                                Text="{Binding TranslationProperties.NeverUpdateThisGameText, Mode=OneWay}"
                                IsChecked="{Binding SkipUpdates, Mode=OneWay}"
                                Command="{Binding ToggleSkipUpdatesCommand}" />

                            <ToggleMenuFlyoutItem
                                Text="{Binding TranslationProperties.FavouriteText, Mode=OneWay}"
                                IsChecked="{Binding Game.IsFavourite, Mode=OneWay}"
                                Command="{Binding FavouriteCommand}" />

                            <ToggleMenuFlyoutItem
                                Text="{Binding TranslationProperties.HideThisGameText, Mode=OneWay}"
                                IsChecked="{Binding Game.IsHidden, Mode=OneWay}"
                                Command="{Binding ShowHideGameCommand}" />

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem
                                Text="{Binding TranslationProperties.NotesText, Mode=OneWay}"
                                Command="{Binding EditNotesCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                Text="{Binding TranslationProperties.HistoryText, Mode=OneWay}"
                                Command="{Binding ViewHistoryCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                Text="{Binding TranslationProperties.ReloadText, Mode=OneWay}"
                                Command="{Binding ReloadGameCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <!-- Last, and behind a separator: the only one that undoes anything. -->
                            <MenuFlyoutSeparator Visibility="{Binding CanChangeDllsVisibility}" />

                            <MenuFlyoutItem
                                Text="{Binding TranslationProperties.ResetAllText, Mode=OneWay}"
                                Visibility="{Binding CanChangeDllsVisibility}"
                                Command="{Binding ResetAllCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED62;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

            </StackPanel>

            <!--
                Close is gone: a dialog needs dismissing, a page needs somewhere to go, and the
                header's "← All games" is that. Two controls doing one thing, one of them named
                after the old shape, is worse than either alone. Escape still works — it is on the
                page now rather than on this button.

                Remove stays here, apart from the actions on the left, because it is the only one
                that deletes anything.
            -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" XYFocusKeyboardNavigation="Enabled" Padding="0"  Spacing="8">
                <Button Content="{Binding TranslationProperties.RemoveText, Mode=OneWay}" Visibility="{Binding IsManuallyAdded, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding RemoveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
