<Page
    x:Class="DLSS_Swapper.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:helpers="using:DLSS_Swapper.Helpers"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:system="using:System"
    xmlns:local="using:DLSS_Swapper"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:ct_winui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    x:Name="RootPage">
    <Page.Resources>
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToNegationVisibilityConverter"  TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </Page.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,0,16,0">
            <TextBlock Margin="16,0,0,0" Text="{x:Bind ViewModel.TranslationProperties.PageTitle, Mode=OneWay}" TextWrapping="NoWrap" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />

            <!--
                Reserves the height the other pages' command bars take, so the title sits on the
                same line throughout. It was a disabled AppBarButton with an empty label, which is a
                control: it appeared in the accessibility tree as a nameless disabled button on a
                page that has no buttons at all. Raw keeps it out of that tree entirely, and it was
                never anything but a gap.
            -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                AutomationProperties.AccessibilityView="Raw">
                <AppBarButton
                    Label=""
                    IsEnabled="False"
                    IsTabStop="False"
                    AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AdminInfoBar"
                 Grid.Row="1"
                 IsOpen="True"
                 Severity="Warning"
                 IsClosable="False"
                 Title="{x:Bind ViewModel.TranslationProperties.WarningText, Mode=OneWay}"
                 Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                 Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer Grid.Row="2">
            <Grid Padding="56,0,56,56" ColumnSpacing="40" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="560" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!--
                    Two columns, because these are two kinds of thing. The left is what the
                    app does and how it looks, read top to bottom and changed often. The right
                    is what it found and what it is, referred to rather than adjusted.
                -->
                <StackPanel Grid.Column="0">
                    <usercontrols:SectionRule
                        Margin="0,4,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.AppearanceText, Mode=OneWay}" />

                    <!--
                        One row of three segments rather than a stack of radio buttons. The three are
                        one choice and read as one control, and it puts the theme on the same shape as
                        every other setting on the page instead of a list floating under a heading.
                    -->
                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.ThemeModeText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.ThemeDescriptionText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <Border
                                BorderThickness="1"
                                BorderBrush="{ThemeResource DsLine2Brush}"
                                CornerRadius="{StaticResource DsCornerRadius}">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        MinWidth="72"
                                        Height="30"
                                        Padding="12,0"
                                        CornerRadius="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Command="{x:Bind ViewModel.SelectThemeCommand}"
                                        CommandParameter="Light">
                                        <Grid>
                                            <!-- The selected fill, behind the label, so the label keeps its own colour. -->
                                            <Border
                                                Margin="-12,-8"
                                                Background="{ThemeResource DsSelectedBrush}"
                                                Visibility="{x:Bind ViewModel.LightThemeSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.TranslationProperties.ThemeLightText, Mode=OneWay}"
                                                FontSize="13"
                                                Foreground="{ThemeResource DsTextPrimaryBrush}" />
                                        </Grid>
                                    </Button>

                                    <Border Width="1" Background="{ThemeResource DsLine2Brush}" />

                                    <Button
                                        MinWidth="72"
                                        Height="30"
                                        Padding="12,0"
                                        CornerRadius="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Command="{x:Bind ViewModel.SelectThemeCommand}"
                                        CommandParameter="Dark">
                                        <Grid>
                                            <Border
                                                Margin="-12,-8"
                                                Background="{ThemeResource DsSelectedBrush}"
                                                Visibility="{x:Bind ViewModel.DarkThemeSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.TranslationProperties.ThemeDarkText, Mode=OneWay}"
                                                FontSize="13"
                                                Foreground="{ThemeResource DsTextPrimaryBrush}" />
                                        </Grid>
                                    </Button>

                                    <Border Width="1" Background="{ThemeResource DsLine2Brush}" />

                                    <Button
                                        MinWidth="72"
                                        Height="30"
                                        Padding="12,0"
                                        CornerRadius="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Command="{x:Bind ViewModel.SelectThemeCommand}"
                                        CommandParameter="Default">
                                        <Grid>
                                            <Border
                                                Margin="-12,-8"
                                                Background="{ThemeResource DsSelectedBrush}"
                                                Visibility="{x:Bind ViewModel.DefaultThemeSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.TranslationProperties.ThemeSystemSettingDefaultText, Mode=OneWay}"
                                                FontSize="13"
                                                Foreground="{ThemeResource DsTextPrimaryBrush}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>


                    <!--
                        The accent, which the app has been able to change without a restart since the
                        brushes were built for it, but had no way to choose. Each swatch is named as
                        well as coloured: four colours told apart by colour alone is exactly the thing
                        this redesign removed everywhere else.
                    -->
                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.AccentText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.AccentDescription, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.AccentSwatches, Mode=OneWay}"
                                Opacity="{x:Bind ViewModel.AccentSwatchesOpacity, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.AccentSwatchesEnabled, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:AccentSwatchItem">
                                        <Button
                                            Width="34"
                                            Height="34"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="{StaticResource DsCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind Name}"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            Command="{x:Bind SelectCommand}"
                                            CommandParameter="{x:Bind}">
                                            <Grid>
                                                <!-- A ring rather than a tick, which would not read at this size. -->
                                                <Border
                                                    Width="34"
                                                    Height="34"
                                                    BorderThickness="2"
                                                    CornerRadius="{StaticResource DsCornerRadius}"
                                                    BorderBrush="{ThemeResource DsTextPrimaryBrush}"
                                                    Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                                                <Border
                                                    Width="26"
                                                    Height="26"
                                                    CornerRadius="{StaticResource DsCornerRadius}"
                                                    Background="{x:Bind Fill, Mode=OneWay}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.MatchDesktopAccentText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.MatchDesktopAccentDescriptionText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.MatchDesktopAccent, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <!-- 36 like every other mid-page section; only a column's first rule sits at 4. -->
                    <usercontrols:SectionRule
                        Margin="0,36,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.BehaviourText, Mode=OneWay}" />

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.AllowUntrustedText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.AllowUntrustedInfo, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AllowUntrusted, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

<usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.AllowDebugDllsText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.AllowDebugDllsInfo, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AllowDebugDlls, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

<usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.ShowOnlyDownloadedDllsText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.ApliesOnlyToDllPickerNotLibraryText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.OnlyShowDownloadedDlls, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <!--
                        The key is the user's own and there is no way around that: SteamGridDB issues
                        them to people, and one shipped inside an open source client is one anybody
                        can read back out of it. So the row has to carry the instructions for getting
                        one, not just a box to paste it into. The link goes straight to the page that
                        generates it rather than to the site's front door.
                    -->


                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.HideNonDLSSGamesText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.HideNonDLSSGamesInfo, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.HideNonDLSSGames, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.BackupNewGamesText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.BackupNewGamesInfo, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.BackupNewGamesAutomatically, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

<usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.SteamGridDbKeyText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.SteamGridDbKeyInfo, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <StackPanel Spacing="4" MinWidth="240">
                                <!--
                                    A draft until saved. This box used to write into settings on
                                    every keystroke, unvalidated, while the Find Covers prompt
                                    checked a key before keeping it - so a key mistyped here failed
                                    every later search silently. Save runs the same check the
                                    prompt does and says what it found, in words below the box.
                                -->
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Text="{x:Bind ViewModel.SteamGridDbApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{x:Bind ViewModel.TranslationProperties.SteamGridDbKeyPlaceholderText, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Content="{x:Bind ViewModel.TranslationProperties.SteamGridDbSaveKeyText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SaveSteamGridDbKeyCommand}" />
                                </Grid>
                                <TextBlock
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Text="{x:Bind ViewModel.SteamGridDbKeyStatusText, Mode=OneWay}"
                                    Foreground="{ThemeResource DsTextSecondaryBrush}" />
                                <HyperlinkButton
                                    Padding="0"
                                    NavigateUri="https://www.steamgriddb.com/profile/preferences/api"
                                    Content="{x:Bind ViewModel.TranslationProperties.SteamGridDbGetKeyText, Mode=OneWay}" />
                            </StackPanel>
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>




                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.NetworkingText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.NetworkingDescText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <Button Content="{x:Bind ViewModel.TranslationProperties.ProxySettingsText, Mode=OneWay}" Command="{x:Bind ViewModel.OpenProxySettingsCommand}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.LoggingText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.LoggingDescText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox x:Name="LoggingComboBox" ItemsSource="{x:Bind ViewModel.LoggingLevelOptions}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.LoggingLevel, Mode=TwoWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <!--
                        Still its own block rather than the row's description, because a description
                        is a string and this is a link. It hugs the Logging row above and keeps its
                        distance from the Language row below, so it reads as belonging to logging.
                        OneWay, not OneTime: the page is cached for the process lifetime, and the
                        path carries today's date, so an app left open overnight named yesterday's
                        file.
                    -->
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,6,0,14" Foreground="{ThemeResource DsTextTertiaryBrush}">
                        <Run Text="{x:Bind ViewModel.TranslationProperties.YourCurrentLogfileText, Mode=OneWay}" /><Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenLogFileCommand}"><Run Text="{x:Bind ViewModel.CurrentLogPath, Mode=OneWay}" /></Hyperlink>.
                    </TextBlock>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.LanguageText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.LanguageDescText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox x:Name="LanguageComboBox" ItemsSource="{x:Bind ViewModel.Languages}" DisplayMemberPath="Value" SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <!-- The row names what the button opens, so the button does not have to say it again. -->
                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.OpenTranslationToolboxText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.OpenTranslationToolboxDescText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <Button Content="{x:Bind ViewModel.TranslationProperties.OpenText, Mode=OneWay}" Command="{x:Bind ViewModel.OpenTranslationToolboxCommand}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SectionRule
                        Margin="0,36,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.DLSSOptionsText, Mode=OneWay}" />

                    <!--
                        The three headers were above their dropdowns and the only explanation of any
                        of them was one italic caption below all three, so each control was read
                        before the thing that made it answerable. Same rows as every other setting
                        now, and the sentence that used to be the caption is what each row says.
                    -->
                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.DLSSOptionsGlobalPresetText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.DLSSOptionsGlobalPresetDescText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    MinWidth="180"
                                    IsEnabled="{x:Bind helpers:NVAPIHelper.Instance.IsSupported, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.DlssPresetOptions, Mode=OneTime}"
                                    SelectedItem="{x:Bind ViewModel.SelectedGlobalDlssPreset, Mode=TwoWay}"
                                    DisplayMemberPath="Name" />
                                <Button
                                    Visibility="{x:Bind helpers:NVAPIHelper.Instance.PermissionIssue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.NVAPIErrorCommand, Mode=OneTime}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.NVAPIErrorTooltipText, Mode=OneWay}"
                                    Style="{StaticResource TextBlockButtonStyle}"
                                    VerticalAlignment="Center">
                                    <Button.Content>
                                        <FontIcon Style="{StaticResource ErrorFontIcon}" />
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.DLSSDOptionsGlobalPresetText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.DLSSDOptionsGlobalPresetDescText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox
                                MinWidth="180"
                                IsEnabled="{x:Bind helpers:NVAPIHelper.Instance.IsSupported, Mode=OneTime}"
                                ItemsSource="{x:Bind ViewModel.DlssDPresetOptions, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.SelectedGlobalDlssDPreset, Mode=TwoWay}"
                                DisplayMemberPath="Name" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.DLSSGOptionsGlobalPresetText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.DLSSGOptionsGlobalPresetDescText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox
                                MinWidth="180"
                                IsEnabled="{x:Bind helpers:NVAPIHelper.Instance.IsSupported, Mode=OneTime}"
                                ItemsSource="{x:Bind ViewModel.DlssGPresetOptions, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.SelectedGlobalDlssGPreset, Mode=TwoWay}"
                                DisplayMemberPath="Name" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <!--
                        The one thing true of all three rather than of any one of them, so it stays
                        under the block. Tertiary and upright rather than an italic caption: it is
                        the caveat that stops the rows being read as a guarantee.
                    -->
                    <TextBlock
                        FontSize="11"
                        LineHeight="15"
                        TextWrapping="Wrap"
                        Margin="0,12,0,0"
                        Foreground="{ThemeResource DsTextTertiaryBrush}">
                            <Run Text="{x:Bind ViewModel.TranslationProperties.DLSSPresetInfoTooltipText, Mode=OneWay}" /> <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.DLSSPresetInfoCommand}"><Run Text="{x:Bind ViewModel.TranslationProperties.DLSSPresetInfoText, Mode=OneWay}" /></Hyperlink>.
                    </TextBlock>

                    <usercontrols:SectionRule
                        Margin="0,36,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.DLSSDeveloperOptionsText, Mode=OneWay}" />
                    <!--
                        The same rows as every other setting. This was a header-less combo box and
                        three bare check boxes - the one section still in the pre-redesign shape,
                        and the only one where a control had no sentence saying what flipping it
                        does to a running game.
                    -->
                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.ShowOnScreenIndicatorText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.ShowOnScreenIndicatorInfoText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ComboBox MinWidth="180" ItemsSource="{Binding DLSSOnScreenIndicatorOptions, Mode=OneTime}" SelectedItem="{Binding SelectedDlssOnScreenIndicator, Mode=TwoWay}" DisplayMemberPath="Label" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.EnableLoggingToFileText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.EnableLoggingToFileInfoText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.DlssEnableLogging, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.VerboseLoggingText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.VerboseLoggingInfoText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.DlssVerboseLogging, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.DlssEnableLogging, Mode=OneWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SettingsRow
                        Title="{x:Bind ViewModel.TranslationProperties.EnableLoggingToConsoleWindowText, Mode=OneWay}"
                        Description="{x:Bind ViewModel.TranslationProperties.EnableLoggingToConsoleWindowInfoText, Mode=OneWay}">
                        <usercontrols:SettingsRow.Control>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.DlssLoggingToWindow, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" />
                        </usercontrols:SettingsRow.Control>
                    </usercontrols:SettingsRow>

                    <usercontrols:SectionRule
                        Margin="0,36,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.IgnoredPathsText, Mode=OneWay}" />
                    <StackPanel Margin="0,10,0,0" Spacing="8">
                        <!-- The section says what ignoring means before offering to do it. -->
                        <TextBlock
                            FontSize="12"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.TranslationProperties.IgnoredPathsInfoText, Mode=OneWay}"
                            Foreground="{ThemeResource DsTextSecondaryBrush}" />

                        <Button Content="{x:Bind ViewModel.TranslationProperties.AddIgnoredPathText, Mode=OneWay}" Command="{x:Bind ViewModel.AddIgnoredPathCommand}" />

                        <!--
                            A plain row per path with Remove beside it. Remove used to live inside
                            an Expander, so taking a path off the list meant discovering the row
                            unfolds at all - an action hidden behind an interaction with no cue.
                        -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.IgnoredPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnSpacing="10" Padding="0,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DsLineBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteIgnoredPathCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="{Binding ElementName=RootPage, Path=ViewModel.TranslationProperties.RemoveText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <!-- 4, matching Appearance across the gutter, so the two columns start level. -->
                    <usercontrols:SectionRule
                        Margin="0,4,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.GameLibrariesText, Mode=OneWay}" />
                    <StackPanel Margin="0,10,0,0">
                        <usercontrols:GameLibrarySelectorControl />
                    </StackPanel>

                    <usercontrols:SectionRule
                        Margin="0,36,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.AboutText, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Visibility="{x:Bind local:BuildInfo.IsFromTagBuild, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="{x:Bind ViewModel.TranslationProperties.VersionText, Mode=OneWay}" FontWeight="Bold" />
                            <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenVersionCommand}" >
                                <Run Text="{x:Bind ViewModel.AppVersion}" />
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Visibility="{x:Bind local:BuildInfo.IsFromTagBuild, Converter={StaticResource BoolToNegationVisibilityConverter}}">
                            <Run Text="{x:Bind ViewModel.TranslationProperties.VersionText, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="{x:Bind ViewModel.AppVersion}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Visibility="{x:Bind local:BuildInfo.ShowsGitCommit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="{x:Bind ViewModel.TranslationProperties.BuildCommitText, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="{x:Bind local:BuildInfo.GitCommitShort}" />
                        <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.CopyGitCommitCommand}" AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.CopyCommitText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.CopyCommitText, Mode=OneWay}" FontStyle="Normal" FontSize="12">
                            <Run Text="&#xE8C8;" FontFamily="/Assets/Fonts/Segoe-Fluent-Icons.ttf#Segoe Fluent Icons" />
                        </Hyperlink>
                    </TextBlock>

                    <!-- Absent on a build the release workflow did not stamp, rather than dated 1970. -->
                    <TextBlock Visibility="{x:Bind local:BuildInfo.IsStamped, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="{x:Bind ViewModel.TranslationProperties.BuildDateText, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="{x:Bind local:BuildInfo.BuildDateTimeFormattedString}" />
                    </TextBlock>
                
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0" Spacing="16" >
                        <Button Content="{x:Bind ViewModel.TranslationProperties.CheckForUpdatesText, Mode=OneWay}" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                        <ProgressRing Width="25" Height="25" IsIndeterminate="True" IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        Which repository is which. The app used to list only the original project, which
                        is where its own name and history come from but not where this build does, so
                        the one link it offered went somewhere that has never seen this code. The
                        original is still named, and named first among the things it is owed, because a
                        fork that quietly drops the credit is the worse mistake of the two.
                    -->
                    <RichTextBlock Margin="0,24,0,0">
                        <Paragraph Margin="0,12,0,0">
                            <Run Text="{x:Bind ViewModel.TranslationProperties.ThisBuildText, Mode=OneWay}" />
                            <Hyperlink NavigateUri="https://github.com/dkflint723/swapshelf">dkflint723/swapshelf</Hyperlink>
                        </Paragraph>
                        <Paragraph Margin="0,12,0,0">
                            <Run Text="{x:Bind ViewModel.TranslationProperties.BasedOnText, Mode=OneWay}" />
                            <Hyperlink NavigateUri="https://github.com/beeradmoore/dlss-swapper">beeradmoore/dlss-swapper</Hyperlink>
                        </Paragraph>
                        <Paragraph Margin="0,12,0,0">
                            <Run Text="{x:Bind ViewModel.TranslationProperties.OriginalCommunityText, Mode=OneWay}" />
                            <Hyperlink NavigateUri="https://twitter.com/dlss_swapper">@dlss_swapper</Hyperlink>
                            <Run Text="·" />
                            <Hyperlink NavigateUri="https://www.reddit.com/r/DLSS_Swapper/">r/DLSS_Swapper</Hyperlink>
                        </Paragraph>
                        <Paragraph Margin="0,12,0,0">
                            <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenAcknowledgementsCommand}">
                                <Run Text="{x:Bind ViewModel.TranslationProperties.AcknowledgementsText, Mode=OneWay}" />
                            </Hyperlink>
                        </Paragraph>
                    </RichTextBlock>

                    <usercontrols:SectionRule
                        Margin="0,36,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.GiveFeedbackText, Mode=OneWay}" />
                    <!--
                        Reports go where the changes were made. Sending them to the original project's
                        tracker would ask its maintainer to answer for code they have never seen.
                    -->
                    <RichTextBlock Margin="0,12,0,0">
                        <Paragraph>
                            <Run Text="{x:Bind ViewModel.TranslationProperties.FeedbackForkInfoText, Mode=OneWay}" />
                            <Hyperlink NavigateUri="https://github.com/dkflint723/swapshelf/issues">dkflint723/swapshelf/issues</Hyperlink>
                        </Paragraph>
                    </RichTextBlock>

                    <usercontrols:SectionRule
                        Margin="0,36,0,4"
                        Label="{x:Bind ViewModel.TranslationProperties.TroubleshootingText, Mode=OneWay}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Vertical">
                        <RichTextBlock>
                            <Paragraph Margin="0,12,0,0">
                                <Hyperlink NavigateUri="https://github.com/beeradmoore/dlss-swapper/wiki/Troubleshooting">
                                    <Run Text="{x:Bind ViewModel.TranslationProperties.GeneralTroubleshootingGuideText, Mode=OneWay}" />
                                </Hyperlink>
                            </Paragraph>
                            <Paragraph Margin="0,12,0,0">
                                <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenNetworkTesterCommand}">
                                    <Run Text="{x:Bind ViewModel.TranslationProperties.NetworkTesterText, Mode=OneWay}" />
                                </Hyperlink>
                            </Paragraph>
                            <Paragraph Margin="0,12,0,0">
                                <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenDiagnosticsCommand}">
                                    <Run Text="{x:Bind ViewModel.TranslationProperties.DiagnosticsText, Mode=OneWay}" />
                                </Hyperlink>
                            </Paragraph>
                        </RichTextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
